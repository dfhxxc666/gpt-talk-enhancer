{
  "manifest_version": 3,
  "name": "GPT TalkEnhancer",
  "version": "0.2.0",
  "description": "Conversation Timeline and Prompt Library for ChatGPT/Codex.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["main/chatgpt-api-capture.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
